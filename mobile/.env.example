# Copy to .env. The Android emulator reaches this Mac at 10.0.2.2.
# For a real phone on the same Wi-Fi, use the Mac's network address and set APP_BIND=0.0.0.0 in the root .env.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# Microsoft sign-in: the IDs from the app registration in Microsoft Entra (see the README).
# Leave them empty and the "Continue with Microsoft" button stays hidden.
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_TENANT_ID=
