# Copy to .env and fill in. Never commit .env.
# The passwords go into connection URLs, so use hex values: openssl rand -hex 24

# The PostgreSQL superuser (postgres). Only used to create the database the first time.
DB_ADMIN_PASSWORD=

# The owner of the database (not a superuser). Only the migrations use it.
DB_PASSWORD=

# The login the backend uses. It can read and write rows and nothing else.
DB_APP_PASSWORD=

# Signs login tokens. At least 32 characters: openssl rand -base64 48
JWT_SECRET=

# Keys the stored fingerprints of serial numbers and IMEIs. At least 32 characters:
# openssl rand -base64 48. Changing it makes saved serial numbers stop matching.
SERIAL_HASH_KEY=

# Only emails at these domains can sign up (comma-separated).
# ALLOWED_EMAIL_DOMAINS=asu.edu.jo

# Email. Leave these out to use the bundled Mailpit inbox at http://localhost:8027.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=ASU Lost & Found <no-reply@yourdomain.com>

# Requests that send an email, and sign-in or code attempts, per network address.
# RATE_LIMIT_EMAILS_PER_HOUR=10
# RATE_LIMIT_LOGINS_PER_15_MIN=10
# Posts with photos per student per minute.
# RATE_LIMIT_UPLOADS_PER_MINUTE=5

# The API answers on this machine only, at http://localhost:4000/api.
# Set to 0.0.0.0 to reach it from a phone on the same Wi-Fi.
# APP_BIND=0.0.0.0
