# Only for running the backend outside Docker (npm run start:dev) against the
# database from docker-compose. Copy to .env and use the passwords from the root .env.

DATABASE_URL=postgresql://lostfound_app:DB_APP_PASSWORD@localhost:5434/lostfound
MIGRATION_DATABASE_URL=postgresql://lostfound:DB_PASSWORD@localhost:5434/lostfound
PORT=4000
