{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error",
    "complexity": [
      "error",
      {
        "max": 10
      }
    ],
    "max-depth": [
      "error",
      {
        "max": 3
      }
    ],
    "max-nested-callbacks": [
      "error",
      {
        "max": 3
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 60,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 400,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "src/generated/**"
  ],
  "overrides": [
    {
      "files": [
        "**/*.spec.ts",
        "test/**/*.ts"
      ],
      "rules": {
        "max-lines-per-function": "off",
        "max-nested-callbacks": "off",
        "max-lines": "off"
      }
    }
  ]
}
