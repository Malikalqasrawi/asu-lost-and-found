generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  SECURITY
  ADMIN
}

enum PostType {
  LOST
  FOUND
}

enum PostStatus {
  OPEN
  CLAIMED
  RETURNED
  CLOSED
}

enum ClaimStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  CLOSED
}

/// Why a post is hidden from everyone but its author.
enum HideCause {
  MODERATION
  BAN
}

enum ReportReason {
  SPAM
  FAKE
  OFFENSIVE
  PERSONAL_DETAILS
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationAction {
  HIDE_POST
  RESTORE_POST
  REMOVE_MESSAGE
  DISMISS_REPORTS
  BAN
  UNBAN
}

enum DeskStatus {
  ON_THE_WAY
  AT_DESK
  PICKED_UP
}

enum Category {
  PHONE
  LAPTOP
  WALLET
  KEYS
  BAG
  ID_CARD
  BOOKS
  CLOTHING
  ELECTRONICS
  JEWELRY
  OTHER
}

enum EmailCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  ADMIN_SIGN_IN
}

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique
  fullName         String    @map("full_name")
  passwordHash     String    @map("password_hash")
  role             Role      @default(STUDENT)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(3)
  tokensValidAfter DateTime? @map("tokens_valid_after") @db.Timestamptz(3)
  /// When the student was last emailed about a possible match; one a day at most.
  matchEmailedAt   DateTime? @map("match_emailed_at") @db.Timestamptz(3)
  /// Set while the account is banned; no end date means for good.
  bannedAt         DateTime? @map("banned_at") @db.Timestamptz(3)
  bannedUntil      DateTime? @map("banned_until") @db.Timestamptz(3)
  banReason        String?   @map("ban_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  emailCodes    EmailCode[]
  refreshTokens RefreshToken[]
  posts         Post[]
  claims        Claim[]
  messages      Message[]
  finderOf      Handover[]      @relation("HandoverFinder")
  ownerOf       Handover[]      @relation("HandoverOwner")
  handedOver    Handover[]      @relation("HandoverReturner")
  received      DeskItem[]      @relation("DeskReceiver")
  reports       Report[]        @relation("Reporter")
  resolved      Report[]        @relation("ReportResolver")
  moderated     ModerationLog[] @relation("Moderator")
  moderatedOn   ModerationLog[] @relation("ModeratedStudent")

  @@map("users")
}

model EmailCode {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   EmailCodePurpose
  codeHash  String           @map("code_hash")
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("email_codes")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Issued by the admin website after the emailed code; only these refresh into admin access.
  adminSession Boolean   @default(false) @map("admin_session")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model OutboxEmail {
  id            String    @id @default(uuid(7)) @db.Uuid
  toAddress     String    @map("to_address")
  subject       String
  textBody      String    @map("text_body")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([nextAttemptAt])
  @@map("outbox_emails")
}

model CampusPlace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  posts Post[]

  @@map("campus_places")
}

model Post {
  id           String     @id @default(uuid(7)) @db.Uuid
  authorId     String     @map("author_id") @db.Uuid
  type         PostType
  status       PostStatus @default(OPEN)
  title        String
  description  String     @default("")
  category     Category
  placeId      String     @map("place_id") @db.Uuid
  placeDetails String?    @map("place_details")
  happenedOn   DateTime   @map("happened_on") @db.Date
  hiddenAt     DateTime?  @map("hidden_at") @db.Timestamptz(3)
  hideCause    HideCause? @map("hide_cause")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  place      CampusPlace      @relation(fields: [placeId], references: [id])
  photos     PostPhoto[]
  secret     PostSecret?
  questions  ClaimQuestion[]
  claims     Claim[]
  deskItem   DeskItem?
  handover   Handover?
  moderation ModerationLog[]
  notMine    MatchDismissal[] @relation("DismissedFor")
  dismissed  MatchDismissal[] @relation("DismissedFound")
  reports    Report[]

  @@index([status, createdAt, id])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostPhoto {
  id          String   @id @default(uuid(7)) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  position    Int
  originalKey String   @unique @map("original_key")
  publicKey   String   @unique @map("public_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@map("post_photos")
}

/// What only the finder knows about a found item. Kept apart from the post so
/// that no query for a post can return it by accident.
model PostSecret {
  postId       String  @id @map("post_id") @db.Uuid
  privateNotes String  @default("") @map("private_notes")
  serialHash   String? @map("serial_hash")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_secrets")
}

model ClaimQuestion {
  id       String @id @default(uuid(7)) @db.Uuid
  postId   String @map("post_id") @db.Uuid
  position Int
  text     String

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  answers ClaimAnswer[]

  @@unique([postId, position])
  @@map("claim_questions")
}

model Claim {
  id            String      @id @default(uuid(7)) @db.Uuid
  postId        String      @map("post_id") @db.Uuid
  claimantId    String      @map("claimant_id") @db.Uuid
  status        ClaimStatus @default(PENDING)
  message       String      @default("")
  serialMatches Boolean?    @map("serial_matches")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt     DateTime?   @map("decided_at") @db.Timestamptz(3)

  post     Post          @relation(fields: [postId], references: [id], onDelete: Restrict)
  claimant User          @relation(fields: [claimantId], references: [id], onDelete: Restrict)
  answers  ClaimAnswer[]
  handover Handover?

  @@index([postId, status])
  @@index([claimantId, createdAt])
  @@map("claims")
}

model ClaimAnswer {
  claimId    String @map("claim_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  answer     String

  claim    Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  question ClaimQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([claimId, questionId])
  @@index([questionId])
  @@map("claim_answers")
}

/// A found item the finder takes to the university security office.
model DeskItem {
  postId       String     @id @map("post_id") @db.Uuid
  status       DeskStatus @default(ON_THE_WAY)
  receivedById String?    @map("received_by_id") @db.Uuid
  receivedAt   DateTime?  @map("received_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  post       Post  @relation(fields: [postId], references: [id], onDelete: Restrict)
  receivedBy User? @relation("DeskReceiver", fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([receivedById])
  @@map("desk_items")
}

/// Starts when the finder accepts a claim. The finder and the owner can write
/// to each other, and the owner's pickup code confirms the item changed hands.
model Handover {
  claimId         String    @id @map("claim_id") @db.Uuid
  postId          String    @unique @map("post_id") @db.Uuid
  finderId        String    @map("finder_id") @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  pickupCode      String    @map("pickup_code")
  wrongCodes      Int       @default(0) @map("wrong_codes")
  finderReadAt    DateTime  @default(now()) @map("finder_read_at") @db.Timestamptz(3)
  ownerReadAt     DateTime  @default(now()) @map("owner_read_at") @db.Timestamptz(3)
  finderEmailedAt DateTime? @map("finder_emailed_at") @db.Timestamptz(3)
  ownerEmailedAt  DateTime? @map("owner_emailed_at") @db.Timestamptz(3)
  returnedAt      DateTime? @map("returned_at") @db.Timestamptz(3)
  returnedById    String?   @map("returned_by_id") @db.Uuid
  /// The last message, or the start: the Messages list is sorted by it.
  lastActivityAt  DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  claim      Claim     @relation(fields: [claimId], references: [id], onDelete: Restrict)
  post       Post      @relation(fields: [postId], references: [id], onDelete: Restrict)
  finder     User      @relation("HandoverFinder", fields: [finderId], references: [id], onDelete: Restrict)
  owner      User      @relation("HandoverOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  returnedBy User?     @relation("HandoverReturner", fields: [returnedById], references: [id], onDelete: Restrict)
  messages   Message[]

  @@index([finderId])
  @@index([ownerId])
  @@index([returnedById])
  @@map("handovers")
}

model Message {
  id         String    @id @default(uuid(7)) @db.Uuid
  handoverId String    @map("handover_id") @db.Uuid
  senderId   String    @map("sender_id") @db.Uuid
  text       String
  /// A moderator removed it; the app shows a placeholder instead of the text.
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  handover   Handover        @relation(fields: [handoverId], references: [claimId], onDelete: Cascade)
  sender     User            @relation(fields: [senderId], references: [id], onDelete: Restrict)
  reports    Report[]
  moderation ModerationLog[]

  @@index([handoverId, createdAt, id])
  @@index([senderId])
  @@map("messages")
}

/// A found post the author of a lost post said is not theirs.
model MatchDismissal {
  lostPostId  String   @map("lost_post_id") @db.Uuid
  foundPostId String   @map("found_post_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lostPost  Post @relation("DismissedFor", fields: [lostPostId], references: [id], onDelete: Cascade)
  foundPost Post @relation("DismissedFound", fields: [foundPostId], references: [id], onDelete: Cascade)

  @@id([lostPostId, foundPostId])
  @@index([foundPostId])
  @@map("match_dismissals")
}

/// A student's report of a post or of a chat message, for an admin to review.
model Report {
  id           String       @id @default(uuid(7)) @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  postId       String?      @map("post_id") @db.Uuid
  messageId    String?      @map("message_id") @db.Uuid
  reason       ReportReason
  details      String       @default("")
  status       ReportStatus @default(OPEN)
  resolvedById String?      @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Restrict)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Restrict)
  resolvedBy User?    @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@unique([reporterId, postId])
  @@unique([reporterId, messageId])
  @@index([status, createdAt])
  @@index([postId])
  @@index([messageId])
  @@index([resolvedById])
  @@map("reports")
}

/// What each admin did, and when. Only ever added to.
model ModerationLog {
  id        String           @id @default(uuid(7)) @db.Uuid
  adminId   String           @map("admin_id") @db.Uuid
  action    ModerationAction
  postId    String?          @map("post_id") @db.Uuid
  messageId String?          @map("message_id") @db.Uuid
  studentId String?          @map("student_id") @db.Uuid
  /// The ban reason, for bans.
  note      String           @default("")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  admin   User     @relation("Moderator", fields: [adminId], references: [id], onDelete: Restrict)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Restrict)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Restrict)
  student User?    @relation("ModeratedStudent", fields: [studentId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([adminId])
  @@index([postId])
  @@index([messageId])
  @@index([studentId])
  @@map("moderation_log")
}
