generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  SECURITY
  ADMIN
}

enum EmailCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique
  fullName         String    @map("full_name")
  passwordHash     String    @map("password_hash")
  role             Role      @default(STUDENT)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(3)
  tokensValidAfter DateTime? @map("tokens_valid_after") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  emailCodes    EmailCode[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model EmailCode {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   EmailCodePurpose
  codeHash  String           @map("code_hash")
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("email_codes")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model OutboxEmail {
  id            String    @id @default(uuid(7)) @db.Uuid
  toAddress     String    @map("to_address")
  subject       String
  textBody      String    @map("text_body")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([nextAttemptAt])
  @@map("outbox_emails")
}
