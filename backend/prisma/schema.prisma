generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  SECURITY
  ADMIN
}

enum PostType {
  LOST
  FOUND
}

enum PostStatus {
  OPEN
  RETURNED
  CLOSED
}

enum Category {
  PHONE
  LAPTOP
  WALLET
  KEYS
  BAG
  ID_CARD
  BOOKS
  CLOTHING
  ELECTRONICS
  JEWELRY
  OTHER
}

enum EmailCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique
  fullName         String    @map("full_name")
  passwordHash     String    @map("password_hash")
  role             Role      @default(STUDENT)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(3)
  tokensValidAfter DateTime? @map("tokens_valid_after") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  emailCodes    EmailCode[]
  refreshTokens RefreshToken[]
  posts         Post[]

  @@map("users")
}

model EmailCode {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   EmailCodePurpose
  codeHash  String           @map("code_hash")
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("email_codes")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model OutboxEmail {
  id            String    @id @default(uuid(7)) @db.Uuid
  toAddress     String    @map("to_address")
  subject       String
  textBody      String    @map("text_body")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([nextAttemptAt])
  @@map("outbox_emails")
}

model CampusPlace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  posts Post[]

  @@map("campus_places")
}

model Post {
  id           String     @id @default(uuid(7)) @db.Uuid
  authorId     String     @map("author_id") @db.Uuid
  type         PostType
  status       PostStatus @default(OPEN)
  title        String
  description  String     @default("")
  category     Category
  placeId      String     @map("place_id") @db.Uuid
  placeDetails String?    @map("place_details")
  happenedOn   DateTime   @map("happened_on") @db.Date
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  place  CampusPlace @relation(fields: [placeId], references: [id])
  photos PostPhoto[]

  @@index([status, createdAt, id])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostPhoto {
  id          String   @id @default(uuid(7)) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  position    Int
  originalKey String   @unique @map("original_key")
  publicKey   String   @unique @map("public_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@map("post_photos")
}
